# MongoDB connection (local or Atlas)
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio_db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional: production overrides
# MONGO_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net
# SECRET_KEY=replace-with-a-secure-value
# SENTRY_DSN=
# EMAIL_FROM=you@example.com

# Notes:
# - Copy this file to `backend/.env` and replace placeholder values before running.
# - Keep secrets out of version control; use your deployment platform's secret store for production.
