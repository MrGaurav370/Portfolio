# MongoDB connection (local or Atlas)
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio_db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Required to use write endpoints (PUT/POST/DELETE) and read contact messages.
# Send it as the X-Admin-Key header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Seed default data on startup when the database is empty
AUTO_SEED=true

# Max contact-form messages per IP per hour
CONTACT_RATE_LIMIT=5
